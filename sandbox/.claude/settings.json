{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 2 -X POST -H \"Content-Type: application/json\" --data-binary @- http://localhost:4000/events >/dev/null 2>&1 || true" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "curl -s -m 2 -X POST -H \"Content-Type: application/json\" --data-binary @- http://localhost:4000/events >/dev/null 2>&1 || true" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 2 -X POST -H \"Content-Type: application/json\" --data-binary @- http://localhost:4000/events >/dev/null 2>&1 || true" }] }
    ]
  }
}
